.gradle/
build/

# bin/ is deliberately NOT ignored: Run.bat launches from it, and it is tracked so
# a built client can be diffed against the Phase 0.2 baseline in
# _client-backup-*/BIN-BASELINE.sha256 (see CLIENT_REFACTORING_PLAN.md).

# Golden-master captures from Record.bat (Phase 0.3). These are per-session
# artefacts meant to be compared locally, not committed.
packet-tap-*.log
golden-master*.log

# Compiled output of the tools/typeaware rewriters (RenameTypes / MoveToPackages).
# Built on demand with `javac -d tools/typeaware/out ...`; the SOURCE is tracked.
tools/typeaware/out/
